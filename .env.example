# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite — REQUIRED at build time) ─
VITE_APP_ID=              # OAuth application ID
VITE_GOOGLE_CLIENT_ID=    # Google OAuth client ID (exposed to browser)
VITE_DISCORD_CLIENT_ID=   # Discord OAuth client ID (exposed to browser)
VITE_GOOGLE_REDIRECT_URI= # Production Google OAuth callback URL (build-time)
                         # e.g. https://tsgarmy-fc.onrender.com/api/oauth/google/callback
VITE_DISCORD_REDIRECT_URI=# Production Discord OAuth callback URL (build-time)
                         # e.g. https://tsgarmy-fc.onrender.com/api/oauth/discord/callback

# ── OAuth Credentials (server-side only — REQUIRED in production) ─
GOOGLE_CLIENT_ID=           # Google OAuth client ID (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=       # Google OAuth client secret
GOOGLE_REDIRECT_URI=        # Production Google OAuth callback URL (server-side)
                           # Must match VITE_GOOGLE_REDIRECT_URI exactly
DISCORD_CLIENT_ID=          # Discord OAuth application/client ID (snowflake from Discord Developer Portal)
DISCORD_CLIENT_SECRET=    # Discord OAuth client secret
DISCORD_REDIRECT_URI=      # Production Discord OAuth callback URL (server-side)
                          # Must match VITE_DISCORD_REDIRECT_URI exactly

# ── Admin Role ──────────────────────────────────────────────────
OWNER_GOOGLE_EMAIL=       # Google email of the app creator; this user gets role "admin" on first login
OWNER_DISCORD_ID=         # Discord user ID of the app creator; this user gets role "admin" on first login
OWNER_UNION_ID=           # Union ID for cross-platform users (optional)

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=           # Resend API key
EMAIL_FROM=               # From address (e.g. TSG <no-reply@tsg.gg>)

# ── Object Storage (S3-compatible) ─────────────────────────────
# Required for permanent media uploads in production.
# If not set, the app falls back to local filesystem storage (ephemeral on Render).
# Compatible providers: AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO, etc.
AWS_ACCESS_KEY_ID=        # S3 access key ID
AWS_SECRET_ACCESS_KEY=    # S3 secret access key
AWS_REGION=               # S3 region (e.g. us-east-1, sgp1)
S3_BUCKET=                # S3 bucket name
S3_ENDPOINT=              # S3 endpoint URL (required for non-AWS providers like DO Spaces, R2)
S3_FORCE_PATH_STYLE=true  # Use path-style URLs (required for some providers)
CDN_BASE_URL=             # Optional CDN base URL for serving assets (e.g. https://cdn.example.com)
